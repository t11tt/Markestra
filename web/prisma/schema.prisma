generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A merchant account owns exactly one workspace.
model Workspace {
  id        String      @id
  slug      String      @unique
  name      String
  user      User?
  brand     Brand?
  products  Product[]
  campaigns Campaign[]
  orders    ShopOrder[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  workspaceId  String    @unique
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions     Session[]
  createdAt    DateTime  @default(now())
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Brand {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  address     String
  hours       String
  style       String
  audience    String
  updatedAt   DateTime  @updatedAt
}

model Product {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  price         Float
  originalPrice Float?
  description   String
  image         String?
  stock         Int       @default(100)
  listed        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId])
}

/// A customer order placed on the merchant's own storefront.
model ShopOrder {
  id            String          @id @default(cuid())
  workspaceId   String
  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  code          String          @unique
  customerName  String
  phone         String
  fulfillment   String
  address       String?
  note          String?
  status        String
  total         Float
  createdAt     DateTime        @default(now())
  items         ShopOrderItem[]

  @@index([workspaceId])
}

model ShopOrderItem {
  id        String    @id @default(cuid())
  orderId   String
  order     ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  name      String
  price     Float
  qty       Int

  @@index([orderId])
}

/// Facts are copied onto the campaign at creation time.
/// Later product edits must not rewrite this row.
model Campaign {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  code          String    @unique
  name          String
  type          String
  goal          String
  status        String
  productId     String?
  productName   String
  productDetail String
  price         Float
  originalPrice Float?
  startDate     String
  endDate       String
  channels      Json
  image         String?
  images        Json      @default("[]")
  category      String    @default("")
  offer         String    @default("")
  posterStyle   String    @default("tea")
  intent        String    @default("")
  contents      Json
  metrics       Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  parentId      String?
  parent        Campaign?  @relation("CampaignRounds", fields: [parentId], references: [id], onDelete: SetNull)
  rounds        Campaign[] @relation("CampaignRounds")
  generations   Generation[]
  versions      ContentVersion[]
  exports       ExportRecord[]
  publications  Publication[]
  metricEntries MetricEntry[]
  reviews       ReviewNote[]

  @@index([workspaceId])
}

model ExportRecord {
  id         String          @id @default(cuid())
  campaignId String
  campaign   Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  versionId  String?
  version    ContentVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  channel    String
  title      String
  body       String
  price      Float
  posterFile String?
  createdAt  DateTime        @default(now())

  @@index([campaignId])
}

model Publication {
  id          String          @id @default(cuid())
  campaignId  String
  campaign    Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  versionId   String?
  version     ContentVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  channel     String
  publishedAt DateTime
  link        String?
  note        String?
  createdAt   DateTime        @default(now())

  @@index([campaignId])
}

model MetricEntry {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channel    String
  metric     String
  value      Float
  observedOn String
  window     String
  source     String
  demo       Boolean  @default(false)
  dedupeKey  String   @unique
  createdAt  DateTime @default(now())

  @@index([campaignId])
}

model ReviewNote {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  observation  String
  limitation   String
  suggestion   String
  basis        String
  createdAt    DateTime @default(now())

  @@index([campaignId])
}

model Generation {
  id            String   @id @default(cuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  model         String
  promptVersion String
  inputSnapshot Json
  output        Json?
  status        String
  error         String?
  createdAt     DateTime @default(now())

  @@index([campaignId])
}

model ContentVersion {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channel      String
  title        String
  body         String
  tags         Json
  cta          String
  confirmed    Boolean        @default(false)
  source       String
  generationId String?
  createdAt    DateTime       @default(now())
  exports      ExportRecord[]
  publications Publication[]

  @@index([campaignId, channel])
}
